diff -ruN cstimer-master/src/js/tools/wca.js zt/src/js/tools/wca.js
--- cstimer-master/src/js/tools/wca.js	1970-01-01 00:00:00.000000000 +0000
+++ zt/src/js/tools/wca.js	2026-11-17 04:17:59.001257724 +0000
@@ -0,0 +1,160 @@
+"use strict";
+
+/*
+ * ZTimer Web: WCA data tool (world records, upcoming competitions, WCA ID lookup).
+ * Idea from the WCA pages of the ZTimer Android app. New code, Copyright (C) 2026 Zel (ZelCubes), GPL-3.0.
+ * Data comes live from the public WCA API. All of it belongs to the World Cube Association.
+ */
+var wcaTool = execMain(function() {
+	var API = 'https://www.worldcubeassociation.org/api/v0/';
+	var EVENTS = [['333', '3x3'], ['222', '2x2'], ['444', '4x4'], ['555', '5x5'], ['666', '6x6'], ['777', '7x7'],
+		['333bf', '3x3 Blindfolded'], ['333fm', '3x3 Fewest Moves'], ['333oh', '3x3 One-Handed'], ['clock', 'Clock'],
+		['minx', 'Megaminx'], ['pyram', 'Pyraminx'], ['skewb', 'Skewb'], ['sq1', 'Square-1'],
+		['444bf', '4x4 Blindfolded'], ['555bf', '5x5 Blindfolded'], ['333mbf', '3x3 Multi-Blind']];
+	var tab = 'records';
+	var body;
+
+	function esc(s) {
+		return String(s == null ? '' : s).replace(/[&<>"]/g, function(c) {
+			return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;'}[c];
+		});
+	}
+
+	function fmt(ev, v, isAvg) {
+		if (!v || v <= 0) {
+			return '-';
+		}
+		if (ev == '333fm') {
+			return isAvg ? (v / 100).toFixed(2) : String(v);
+		}
+		if (ev == '333mbf') {
+			var missed = v % 100, secs = Math.floor(v / 100) % 100000, diff = 99 - Math.floor(v / 10000000) % 100;
+			var solved = diff + missed;
+			return solved + '/' + (solved + missed) + ' ' + Math.floor(secs / 60) + ':' + ('0' + (secs % 60)).slice(-2);
+		}
+		var s = v / 100;
+		if (s >= 60) {
+			var m = Math.floor(s / 60);
+			return m + ':' + ('0' + (s - m * 60).toFixed(2)).slice(-5);
+		}
+		return s.toFixed(2);
+	}
+
+	function get(path, ok) {
+		body.html('Loading...');
+		var mine = body;
+		fetch(API + path).then(function(r) {
+			if (!r.ok) {
+				throw new Error(r.status);
+			}
+			return r.json();
+		}).then(function(j) {
+			if (mine == body) {
+				ok(j);
+			}
+		}).catch(function() {
+			if (mine == body) {
+				body.html('Could not load data from the WCA. Check your connection or the WCA ID and try again.');
+			}
+		});
+	}
+
+	function records() {
+		get('records', function(j) {
+			var wr = j.world_records || {};
+			var h = '<table class="table" style="margin:auto;"><tr><th>Event</th><th>Single</th><th>Average</th></tr>';
+			EVENTS.forEach(function(e) {
+				var r = wr[e[0]];
+				if (r) {
+					h += '<tr><td>' + esc(e[1]) + '</td><td>' + fmt(e[0], r.single, false) + '</td><td>' + fmt(e[0], r.average, true) + '</td></tr>';
+				}
+			});
+			body.html('<b>World records</b><br>' + h + '</table>');
+		});
+	}
+
+	function competitions() {
+		var country = (localStorage['ztimer.wcaCountry'] || '').toUpperCase();
+		var input = $('<input type="text" maxlength="2" style="width:2em; text-align:center;">').val(country);
+		var d = new Date();
+		var today = d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
+		var ctl = $('<div>Country code (e.g. US, blank for worldwide): </div>').append(input, ' ',
+			$('<input type="button">').val('Go').click(function() {
+				localStorage['ztimer.wcaCountry'] = input.val().toUpperCase();
+				competitions();
+			}));
+		var q = 'competitions?sort=start_date&per_page=25&start=' + today + (country.length == 2 ? '&country_iso2=' + country : '');
+		get(q, function(j) {
+			var h = '<table class="table" style="margin:auto; text-align:left;">';
+			(j || []).forEach(function(c) {
+				h += '<tr><td>' + esc(c.start_date) + (c.end_date != c.start_date ? '<br>' + esc(c.end_date) : '') + '</td><td><a class="click" target="_blank" rel="noopener" href="https://www.worldcubeassociation.org/competitions/' +
+					encodeURIComponent(c.id) + '">' + esc(c.name) + '</a><br>' + esc(c.city) + ' ' + esc(c.country_iso2) + '</td></tr>';
+			});
+			body.empty().append('<b>Upcoming competitions</b><br>', ctl, h + (j && j.length ? '' : '<tr><td>No upcoming competitions found.</td></tr>') + '</table>');
+		});
+	}
+
+	function person() {
+		var id = $('<input type="text" maxlength="10" style="width:8em;" placeholder="2015ABCD01">').val(localStorage['ztimer.wcaId'] || '');
+		var out = $('<div>');
+		var ctl = $('<div>WCA ID: </div>').append(id, ' ', $('<input type="button">').val('Look up').click(function() {
+			var v = id.val().toUpperCase().replace(/[^0-9A-Z]/g, '');
+			localStorage['ztimer.wcaId'] = v;
+			if (!/^\d{4}[A-Z]{4}\d{2}$/.test(v)) {
+				out.html('A WCA ID looks like 2015ABCD01.');
+				return;
+			}
+			out.html('Loading...');
+			fetch(API + 'persons/' + v).then(function(r) {
+				if (!r.ok) {
+					throw new Error(r.status);
+				}
+				return r.json();
+			}).then(function(j) {
+				var p = j.person || {}, pr = j.personal_records || {};
+				var h = '<b>' + esc(p.name) + '</b> (' + esc(p.country_iso2) + ') - <a class="click" target="_blank" rel="noopener" href="https://www.worldcubeassociation.org/persons/' + v + '">' + v + '</a><br>' +
+					'Competitions: ' + esc(j.competition_count) + '<table class="table" style="margin:auto;"><tr><th>Event</th><th>Single</th><th>NR</th><th>WR</th><th>Average</th><th>NR</th><th>WR</th></tr>';
+				EVENTS.forEach(function(e) {
+					var r = pr[e[0]];
+					if (r) {
+						var s = r.single || {}, a = r.average || {};
+						h += '<tr><td>' + esc(e[1]) + '</td><td>' + fmt(e[0], s.best, false) + '</td><td>' + esc(s.country_rank || '-') + '</td><td>' + esc(s.world_rank || '-') +
+							'</td><td>' + fmt(e[0], a.best, true) + '</td><td>' + esc(a.country_rank || '-') + '</td><td>' + esc(a.world_rank || '-') + '</td></tr>';
+					}
+				});
+				out.html(h + '</table>');
+			}).catch(function() {
+				out.html('Could not find that WCA ID, or the WCA could not be reached.');
+			});
+		}));
+		body.empty().append(ctl, out);
+	}
+
+	function show() {
+		({records: records, competitions: competitions, person: person})[tab]();
+	}
+
+	function execFunc(fdiv) {
+		if (!fdiv) {
+			body = null;
+			return;
+		}
+		body = $('<div style="margin-top:0.5em;">');
+		var tabs = $('<div>');
+		[['records', 'Records'], ['competitions', 'Competitions'], ['person', 'WCA ID']].forEach(function(t) {
+			tabs.append($('<span class="click" style="margin:0 0.6em;">').html(t[1]).click(function() {
+				tab = t[0];
+				body = $('<div style="margin-top:0.5em;">').replaceAll(body);
+				show();
+			}));
+		});
+		fdiv.empty().append(tabs, body, '<div style="font-size:0.75em; margin-top:0.8em;">Data: World Cube Association, ' +
+			'<a class="click" target="_blank" rel="noopener" href="https://www.worldcubeassociation.org/">worldcubeassociation.org</a>, through its public API. ' +
+			'All competition data is owned and maintained by the WCA. ZTimer Web is not affiliated with the WCA.</div>');
+		show();
+	}
+
+	$(function() {
+		tools.regTool('wca', 'WCA data', execFunc);
+	});
+});
diff -ruN cstimer-master/src/js/tools/zquick.js zt/src/js/tools/zquick.js
--- cstimer-master/src/js/tools/zquick.js	1970-01-01 00:00:00.000000000 +0000
+++ zt/src/js/tools/zquick.js	2026-11-17 04:17:59.000410363 +0000
@@ -0,0 +1,34 @@
+"use strict";
+
+/*
+ * ZTimer Web: quick action buttons under the timer (OK, +2, DNF, delete, comment).
+ * Idea from the ZTimer Android app's quick actions. New code, Copyright (C) 2026 Zel (ZelCubes), GPL-3.0.
+ * It only sends csTimer's own 'ctrl' signals, the same ones its keyboard shortcuts use.
+ */
+var zquick = execMain(function() {
+	var bar = $('<div id="zquick" style="margin-top:0.6em; text-align:center;"/>');
+
+	function btn(label, cmd, title) {
+		return $('<input type="button" style="margin:0 0.2em;">').val(label).attr('title', title).click(function() {
+			kernel.pushSignal('ctrl', ['stats', cmd]);
+		});
+	}
+
+	function update() {
+		bar.toggle(!!kernel.getProp('zQuick'));
+	}
+
+	$(function() {
+		kernel.regProp('ui', 'zQuick', 0, 'Show quick action buttons under the timer', [true], 1);
+		bar.append(btn('OK', 'OK', 'Clear the penalty of the last solve'), btn('+2', '+2', 'Add a 2 second penalty to the last solve'),
+			btn('DNF', 'DNF', 'Mark the last solve as DNF'), btn('Delete', 'undo', 'Delete the last solve'),
+			btn('Comment', 'cmt', 'Add a comment to the last solve'));
+		// do not let a press on these buttons start or stop the timer
+		bar.on('mousedown mouseup touchstart touchend keydown keyup', function(e) {
+			e.stopPropagation();
+		});
+		bar.appendTo('#container');
+		kernel.regListener('zquick', 'property', update, /^zQuick$/);
+		update();
+	});
+});
