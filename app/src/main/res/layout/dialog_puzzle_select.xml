<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/outline_background_card"
    android:orientation="vertical">

    <TextView
        android:id="@+id/title"
        style="@style/DialogTitleTextStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_select_puzzle" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/puzzle_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:background="@android:color/transparent"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/md_blue_A700"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/md_blue_A700"
        app:tabTextColor="@color/md_light_primary_text" />

    <!-- Trainer popup tabs: two rows that scroll sideways together (filled in by the dialog) -->
    <HorizontalScrollView
        android:id="@+id/trainer_tabs_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/trainer_tabs_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        tools:layout_height="300dp">

    </androidx.recyclerview.widget.RecyclerView>

</LinearLayout>
