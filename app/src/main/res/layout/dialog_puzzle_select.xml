<?xml version="1.0" encoding="utf-8"?>
<!--
    The select a puzzle / select a trainer popup.
    Outer card: 20dp corners. Everything inside sits 8dp in from the edge, so the things that touch
    the edge area (the tiles) use 20 - 8 = 12dp corners.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_2"
    android:layout_marginBottom="@dimen/space_2"
    android:background="@drawable/outline_background_card"
    android:orientation="vertical"
    android:padding="@dimen/inset">

    <TextView
        android:id="@+id/title"
        style="@style/DialogTitleTextStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_select_puzzle" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/puzzle_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/md_blue_A700"
        app:tabIndicatorHeight="2dp"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/md_blue_A700"
        app:tabTextColor="@color/md_light_primary_text" />

    <!-- Trainer popup tabs: two rows that scroll sideways together, one sliding underline -->
    <HorizontalScrollView
        android:id="@+id/trainer_tabs_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/trainer_tabs_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/trainer_tabs_columns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <View
                android:id="@+id/trainer_tab_indicator"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:background="@drawable/bg_tab_indicator" />
        </FrameLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/black_divider" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingTop="@dimen/space_2"
        android:paddingBottom="@dimen/space_2"
        tools:layout_height="300dp" />

</LinearLayout>
