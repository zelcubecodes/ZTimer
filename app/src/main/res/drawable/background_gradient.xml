<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:opacity="opaque">

    <!-- Launch screen background: the same pastel pink as the app icon -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFCCEA"
                android:endColor="#FFA3D5"
                android:angle="315" />
        </shape>
    </item>

    <!-- Ztimer logo (vector, scales to every screen) -->
    <item
        android:width="216dp"
        android:height="216dp"
        android:gravity="center"
        android:drawable="@drawable/ic_launcher_z" />

</layer-list>
